  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "assets:map-login": "node scripts/extract-map-login-assets.cjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
